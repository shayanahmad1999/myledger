APP_NAME=MyLedger
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Karachi

# Quick local start: SQLite works with the bundled code.
DB_CONNECTION=sqlite

# Recommended production/development database:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=myledger
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

FINANCE_BASE_CURRENCY=PKR
FINANCE_TIMEZONE=Asia/Karachi
FINANCE_DUE_REMINDER_TIME=08:00
FINANCE_ATTACHMENT_DISK=local
